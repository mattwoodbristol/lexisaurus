# The two secrets your tutor needs. The Deploy to Cloudflare button asks for them; for local
# development copy this file to .dev.vars (never commit .dev.vars).
# Session and Web Push keys are generated by the app itself and kept in its database.
PASSPHRASE=choose-a-passphrase-of-12-or-more-characters
ANTHROPIC_API_KEY=sk-ant-your-key
